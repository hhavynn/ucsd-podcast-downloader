{
  "manifest_version": 3,
  "name": "UCSD Podcast Downloader",
  "version": "0.1.0",
  "description": "Detects and downloads UCSD lecture streams.",
  "permissions": ["webRequest", "webNavigation", "storage", "tabs", "nativeMessaging", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UCSD Podcast Downloader"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
